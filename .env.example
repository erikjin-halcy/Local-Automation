# Claude – skapa med: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=
# ...eller använd en API-nyckel istället:
# ANTHROPIC_API_KEY=

# GitHub (mcp: github) – fine-grained token, se README
GITHUB_PAT=

# Slack (mcp: slack) – User OAuth Token (xoxp-...), se README
SLACK_XOXP=

# Google (mcp: google) – OAuth-klient från Google Cloud, se README
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_EMAIL=
