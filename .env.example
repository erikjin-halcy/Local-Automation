# Claude – skapa med: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=
# ...eller använd en API-nyckel istället:
# ANTHROPIC_API_KEY=

# GitHub (mcp: github) – fine-grained token, se README
GITHUB_PAT=

# Linear (mcp: linear) – Personal API key, se README
LINEAR_API_KEY=
POSTHOG_API_KEY=

# Slack (mcp: slack) – User OAuth Token (xoxp-...), se README
SLACK_XOXP=

# Google – samma OAuth-klient för båda kontona, se README
# mcp: google = privat konto, mcp: google-work = jobbkonto
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_EMAIL=
GOOGLE_WORK_EMAIL=
