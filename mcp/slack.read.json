{
  "mcpServers": {
    "slack": {
      "command": "slack-mcp-server",
      "args": [
        "--transport",
        "stdio",
        "-e",
        "channels_list,channels_me,conversations_history,conversations_replies,conversations_search_messages,conversations_unreads,usergroups_list,usergroups_me,users_search"
      ],
      "env": {
        "SLACK_MCP_XOXP_TOKEN": "${SLACK_XOXP}",
        "SLACK_MCP_USERS_CACHE": "/data/slack/users_cache.json",
        "SLACK_MCP_CHANNELS_CACHE": "/data/slack/channels_cache_v2.json"
      }
    }
  }
}
